{{define "layout"}}<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Jīqìrén // panel</title>
<link rel="stylesheet" href="/panel/static/style.css">
</head>
<body>
<header class="bar">
  <a href="/panel" class="brand">[ Jīqìrén ]</a>
  <nav class="nav-row">
    {{range .Nav}}<a class="nav-link{{if .Active}} active{{end}}" href="{{.Href}}">{{.Label}}</a>{{end}}
    <form method="post" action="/panel/logout" class="inline logout"><button type="submit" class="link nav-link">выход</button></form>
  </nav>
  <details class="nav-burger">
    <summary class="icon-select-btn" title="меню">☰</summary>
    <div class="nav-burger-menu">
      {{range .Nav}}<a class="nav-link{{if .Active}} active{{end}}" href="{{.Href}}">{{.Label}}</a>{{end}}
      <form method="post" action="/panel/logout" class="inline logout"><button type="submit" class="link nav-link">выход</button></form>
    </div>
  </details>
</header>
<main>
{{.Body}}
</main>
<dialog id="error-popup" class="popup">
  <p class="popup-message"></p>
  <button type="button" class="popup-close">ок</button>
</dialog>
<script src="/panel/static/panel.js"></script>
</body>
</html>
{{end}}
