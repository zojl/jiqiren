{{define "squad_page"}}
<h1>{{.Code}} {{.Name}} {{if .CanRename}}<a class="icon" href="/panel/squads/{{.Code}}/rename" title="редактировать">✎</a>{{end}}</h1>
<dl class="budget">
  <div class="budget-row">
    <dt>цель</dt>
    <dd>
      {{if .CanSetTarget}}
      <details class="target-picker" data-scope="squad" data-squad-id="{{.Id}}">
        <summary class="icon-select-btn" title="цель отряда">{{.CurrentTargetIcon}}</summary>
        <div class="target-menu">
          {{range .TargetOptions}}<button type="button" class="target-option{{if .Selected}} selected{{end}}" data-value="{{.Value}}" data-target-icon="{{.Icon}}">{{.Icon}} {{.Name}}</button>{{end}}
        </div>
      </details>
      {{else}}
      {{.TargetLabel}}
      {{end}}
    </dd>
  </div>
  <div class="budget-row">
    <dt>чат отряда</dt>
    <dd>
      {{if .ChatName}}
      {{.ChatName}}
      {{if .CanUnbindChat}}<form method="post" action="/panel/squads/{{.Code}}/unbind-chat" onsubmit="return confirm('Отвязать чат?');" class="inline"><button type="submit" class="danger">✕</button></form>{{end}}
      {{else}}
      не привязан
      {{end}}
    </dd>
  </div>
  <div class="budget-row">
    <dt>токен</dt>
    <dd>{{if .HasToken}}установлен{{else}}не задан{{end}} {{if .CanSetToken}}<a class="icon" href="/panel/squads/{{.Code}}/token" title="токен отряда">🗝</a>{{end}}</dd>
  </div>
</dl>

{{if .CanManageSchedule}}
<section class="actions">
  <a class="btn" href="/panel/squads/{{.Code}}/schedule">рассылки</a>
</section>
{{end}}

<h2>участники</h2>
{{if .Members}}
<div class="table-scroll">
<table class="list members">
<tr><th>игрок</th><th>выносл.</th><th>деньги</th><th>цель</th><th>сон (мск)</th><th>атк</th><th>деф</th><th>статы</th>{{if .CanManageMembers}}<th></th>{{end}}</tr>
{{range .Members}}
<tr>
  <td>{{if .Stale}}❄️ {{end}}{{if .IsOverride}}↪ {{end}}<a href="https://vk.com/id{{.VkId}}" target="_blank" rel="noopener">{{.WayIcon}}{{.Name}}({{.Level}})</a> <span class="hint">{{.LastSeen}}</span></td>
  <td class="{{.StaminaClass}}">{{.Stamina}}</td>
  <td class="{{.MoneyClass}}">{{.Money}}</td>
  <td class="{{.TargetClass}}">{{.TargetLabel}}</td>
  <td>{{.SleepAt}}{{if .SleepWarning}} ⚠️{{end}}</td>
  <td>⚔️{{.Attack}}</td>
  <td>🛡️{{.Defense}}</td>
  <td>📡{{.Practice}} 💾{{.Theory}} 📱{{.Cunning}} 🔎{{.Wisdom}}</td>
  {{if $.CanManageMembers}}
  <td>{{if .IsOverride}}<form method="post" action="/panel/squads/{{$.Code}}/members/{{.VkId}}/remove" onsubmit="return confirm('Открепить от отряда?');" class="inline"><button type="submit" class="danger">✕</button></form>{{end}}</td>
  {{end}}
</tr>
{{if .HasReport}}
<tr class="report-row">
  <td colspan="9" class="hint">↳ отчёт за битву: 🔋{{.ReportStamina}} 💵{{.ReportMoney}}</td>
</tr>
{{end}}
{{end}}
</table>
</div>
{{else}}
<p class="hint">нет активных участников за последний месяц</p>
{{end}}

{{if .CanManageMembers}}
<form method="post" action="/panel/squads/{{.Code}}/members" class="form">
  <label>добавить участника (vk id)<input type="text" name="vk_id" required></label>
  <button type="submit">добавить</button>
</form>
{{end}}

{{if .HiddenMembers}}
<details class="hidden-members">
  <summary class="btn">скрытые ({{len .HiddenMembers}})</summary>
  <table class="list">
  <tr><th>игрок</th><th></th><th></th></tr>
  {{range .HiddenMembers}}
  <tr>
    <td><a href="https://vk.com/id{{.VkId}}" target="_blank" rel="noopener">{{.Name}}</a></td>
    <td class="hint">{{.Info}}</td>
    <td>{{if and .IsOverride $.CanManageMembers}}<form method="post" action="/panel/squads/{{$.Code}}/members/{{.VkId}}/remove" onsubmit="return confirm('Вернуть в отряд?');" class="inline"><button type="submit">↩ вернуть</button></form>{{end}}</td>
  </tr>
  {{end}}
  </table>
</details>
{{end}}

{{if .ShowBackLink}}<a class="back" href="/panel">← назад</a>{{end}}
{{end}}
