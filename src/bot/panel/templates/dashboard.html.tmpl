{{define "dashboard"}}
<h1>{{.FractionIcon}} {{.FractionName}}</h1>

<section class="squads">
  <div class="squad-row">
    <a class="squad-link" href="/panel/fraction">{{.FractionIcon}} {{.FractionName}}</a>
  </div>
  {{range .Squads}}
  <div class="squad-row">
    <a class="squad-link" href="/panel/squads/{{.Code}}">{{.Code}} {{.Name}}</a>
    {{if .CanSetTarget}}
    <details class="target-picker" data-scope="squad" data-squad-id="{{.Id}}">
      <summary class="icon-select-btn" title="цель отряда">{{.CurrentTargetIcon}}</summary>
      <div class="target-menu">
        {{range .TargetOptions}}<button type="button" class="target-option{{if .Selected}} selected{{end}}" data-value="{{.Value}}" data-target-icon="{{.Icon}}">{{.Icon}} {{.Name}}</button>{{end}}
      </div>
    </details>
    {{else}}
    <span class="icon" title="цель отряда">{{.CurrentTargetIcon}}</span>
    {{end}}
    {{if .CanRename}}<a class="icon" href="/panel/squads/{{.Code}}/rename" title="редактировать">✎</a>{{end}}
    {{if .CanSetToken}}<a class="icon" href="/panel/squads/{{.Code}}/token" title="токен отряда">🗝</a>{{end}}
  </div>
  {{end}}
</section>

{{if .CanManageSquads}}
<a class="btn btn-wide" href="/panel/squads/new">+ отряд</a>
{{end}}
{{end}}
