{{define "dashboard"}}
<div class="fraction-row">
  <h1><a href="/panel/fraction">{{.FractionIcon}} {{.FractionName}}</a></h1>
  {{if .CanSetFractionTarget}}
  <details class="target-picker" data-scope="fraction">
    <summary class="icon-select-btn" title="цель команды">{{.FractionCurrentTargetIcon}}</summary>
    <div class="target-menu">
      {{range .FractionTargetOptions}}<button type="button" class="target-option{{if .Selected}} selected{{end}}" data-value="{{.Value}}" data-target-icon="{{.Icon}}">{{.Icon}} {{.Name}}</button>{{end}}
    </div>
  </details>
  {{else}}
  <span class="icon" title="цель команды">{{.FractionCurrentTargetIcon}}</span>
  {{end}}
</div>

<section class="squads">
  {{range .Squads}}
  <div class="squad-row">
    <a class="squad-link" href="/panel/squads/{{.Code}}">{{.Code}} {{.Name}}</a>
    {{if .CanSetTarget}}
    <details class="target-picker" data-scope="squad" data-squad-id="{{.Id}}">
      <summary class="icon-select-btn" title="цель отряда">{{.CurrentTargetIcon}}</summary>
      <div class="target-menu">
        {{range .TargetOptions}}<button type="button" class="target-option{{if .Selected}} selected{{end}}" data-value="{{.Value}}" data-target-icon="{{.Icon}}">{{.Icon}} {{.Name}}</button>{{end}}
      </div>
    </details>
    {{else}}
    <span class="icon" title="цель отряда">{{.CurrentTargetIcon}}</span>
    {{end}}
  </div>
  {{end}}
</section>

{{if .CanManageSquads}}
<a class="btn btn-nav btn-wide" href="/panel/squads/new">+ отряд</a>
{{end}}
{{end}}
