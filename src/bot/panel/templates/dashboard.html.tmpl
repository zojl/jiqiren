{{define "dashboard"}}
<section class="fraction-header">
  <h1>{{.FractionIcon}} {{.FractionName}}</h1>
  {{if .CanViewBalance}}
  <details class="budget-dropdown" data-budget-url="/panel/fraction/budget">
    <summary class="btn">баланс</summary>
    <div class="budget-content"></div>
  </details>
  {{end}}
</section>

<section class="squads">
  <div class="squad-row">
    <span class="squad-link">{{.FractionIcon}} {{.FractionName}}</span>
    {{if .CanSetFractionTarget}}
    <select class="icon-select target-select" data-scope="fraction" title="цель команды">
      {{range .FractionTargetOptions}}<option value="{{.Value}}" {{if .Selected}}selected{{end}}>{{.Icon}} {{.Name}}</option>{{end}}
    </select>
    {{else}}
    <span class="icon" title="цель команды">{{.FractionCurrentTargetIcon}}</span>
    {{end}}
    {{if .CanSetFractionToken}}<a class="icon" href="/panel/fraction/token" title="токен команды">🗝</a>{{end}}
  </div>
  {{range .Squads}}
  <div class="squad-row">
    <a class="squad-link" href="/panel/squads/{{.Code}}">{{.Code}} {{.Name}}</a>
    {{if .CanSetTarget}}
    <select class="icon-select target-select" data-scope="squad" data-squad-id="{{.Id}}" title="цель отряда">
      {{range .TargetOptions}}<option value="{{.Value}}" {{if .Selected}}selected{{end}}>{{.Icon}} {{.Name}}</option>{{end}}
    </select>
    {{else}}
    <span class="icon" title="цель отряда">{{.CurrentTargetIcon}}</span>
    {{end}}
    {{if .CanRename}}<a class="icon" href="/panel/squads/{{.Id}}/rename" title="редактировать">✎</a>{{end}}
    {{if .CanSetToken}}<a class="icon" href="/panel/squads/{{.Id}}/token" title="токен отряда">🗝</a>{{end}}
  </div>
  {{end}}
</section>

{{if .CanManageSquads}}
<section class="actions">
  <a class="btn" href="/panel/squads/new">+ отряд</a>
  <a class="btn" href="/panel/managers">менеджеры</a>
  {{if .CanViewAuditLog}}<a class="btn" href="/panel/audit">журнал</a>{{end}}
</section>
{{end}}
{{end}}
