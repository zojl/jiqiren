{{define "audit_log"}}
<h1>журнал действий</h1>
<p class="hint">за последние 2 недели</p>

<form method="get" action="/panel/audit" class="audit-filters">
  <select name="manager_id" onchange="this.form.submit()">
    <option value="">все менеджеры</option>
    {{range .ManagerOptions}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}
  </select>
  <select name="action" onchange="this.form.submit()">
    <option value="">все события</option>
    {{range .ActionOptions}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}
  </select>
</form>

<table class="list">
<tr><th>время</th><th>кто</th><th>действие</th><th>подробности</th></tr>
{{range .Entries}}
<tr>
  <td>{{.Time}}</td>
  <td>{{.Who}}</td>
  <td>{{.Action}}</td>
  <td>{{.Details}}</td>
</tr>
{{end}}
</table>
<a class="back" href="/panel">← назад</a>
{{end}}
