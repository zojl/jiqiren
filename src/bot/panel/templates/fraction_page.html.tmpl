{{define "fraction_page"}}
<h1>{{.Icon}} {{.Name}}</h1>
<dl class="budget">
  <div class="budget-row">
    <dt>цель</dt>
    <dd>
      {{if .CanSetTarget}}
      <details class="target-picker" data-scope="fraction">
        <summary class="icon-select-btn" title="цель команды">{{.CurrentTargetIcon}}</summary>
        <div class="target-menu">
          {{range .TargetOptions}}<button type="button" class="target-option{{if .Selected}} selected{{end}}" data-value="{{.Value}}" data-target-icon="{{.Icon}}">{{.Icon}} {{.Name}}</button>{{end}}
        </div>
      </details>
      {{else}}
      {{.CurrentTargetIcon}}
      {{end}}
    </dd>
  </div>
  <div class="budget-row">
    <dt>токен</dt>
    <dd>{{if .HasToken}}установлен{{else}}не задан{{end}} {{if .CanSetToken}}<a class="icon-select-btn" href="/panel/fraction/token" title="токен команды">🗝</a>{{end}}</dd>
  </div>
</dl>

<h2>сообщение команды{{if .CanSetMessage}} <a class="icon-select-btn" href="/panel/fraction/message" title="редактировать">✎</a>{{end}}</h2>
{{if .Message}}
<p class="pre-line">{{.Message}}</p>
{{else}}
<p class="hint">не задано</p>
{{end}}

<h2>настройки профиля{{if .CanSetSettings}} <a class="icon-select-btn" href="/panel/fraction/settings" title="редактировать">✎</a>{{end}}</h2>
<dl class="budget">
  <div class="budget-row"><dt>выносливость — очень мало</dt><dd>{{.StaminaVerySevere}}</dd></div>
  <div class="budget-row"><dt>выносливость — мало</dt><dd>{{.StaminaSevere}}</dd></div>
  <div class="budget-row"><dt>выносливость — рекомендуется больше</dt><dd>{{.StaminaRecommended}}</dd></div>
  <div class="budget-row"><dt>выносливость — идеально</dt><dd>{{.StaminaIdeal}}</dd></div>
  <div class="budget-row"><dt>деньги — рекомендовано слить</dt><dd>{{.MoneyRecommended}}</dd></div>
  <div class="budget-row"><dt>деньги — много</dt><dd>{{.MoneySevere}}</dd></div>
</dl>
{{end}}
