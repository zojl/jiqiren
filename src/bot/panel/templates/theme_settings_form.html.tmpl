{{define "theme_settings_form"}}
<h1>тема оформления</h1>
<form method="post" action="/panel/settings/theme" class="form settings-form">
  <div class="settings-group">
    <h2>режим</h2>
    <div class="theme-mode-row">
      {{range .Modes}}
      <label class="checkbox-label"><input type="radio" name="mode" value="{{.Id}}"{{if eq .Id $.Mode}} checked{{end}}> {{.Label}}</label>
      {{end}}
    </div>
  </div>

  <div class="settings-group">
    <h2>цветовая схема</h2>
    <div class="theme-scheme-grid">
      {{range .Schemes}}
      <label class="theme-scheme-option">
        <input type="radio" name="scheme" value="{{.Id}}"{{if eq .Id $.Scheme}} checked{{end}}>
        <span class="theme-scheme-preview">
          <span class="theme-scheme-bar" title="день" style="background: linear-gradient(to right, {{.Day.Bg}} 0% 25%, {{.Day.Accent}} 25% 50%, {{.Day.Warn}} 50% 75%, {{.Day.Danger}} 75% 100%)"></span>
          <span class="theme-scheme-bar" title="ночь" style="background: linear-gradient(to right, {{.Night.Bg}} 0% 25%, {{.Night.Accent}} 25% 50%, {{.Night.Warn}} 50% 75%, {{.Night.Danger}} 75% 100%)"></span>
        </span>
        <span class="theme-scheme-name">{{.Label}}</span>
      </label>
      {{end}}
    </div>
  </div>

  <button type="submit">сохранить</button>
</form>
<p class="hint">«авто» переключает день/ночь по настройкам устройства/браузера</p>
<a class="back" href="/panel">← назад</a>
{{end}}
